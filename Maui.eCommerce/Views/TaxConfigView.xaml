<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.TaxConfigView"
             Title="TaxConfig">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Set Tax Rate (%)" FontSize="20"/>
        <Entry Text="{Binding TaxRate, Mode=TwoWay}" Keyboard="Numeric" Placeholder="Enter tax rate"/>
        <Button Text="Save" Clicked="SaveClicked"/>
        <Label Text="{Binding StatusMessage}"/>
        <Button Text="Go Back" Clicked="GoBackClicked"/>
    </VerticalStackLayout>
</ContentPage>
