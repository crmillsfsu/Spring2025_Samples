<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="Maui.eCommerce.Views.CheckoutView"
             Title="Receipt">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <Label Text="Receipt" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            <BoxView HeightRequest="2" HorizontalOptions="Fill" Margin="0,10,0,0" />
        </VerticalStackLayout>

        <!-- Items Header -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Text="Product" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="Price" FontAttributes="Bold" HorizontalOptions="End" />
            <Label Grid.Column="2" Text="Qty" FontAttributes="Bold" HorizontalOptions="End" Margin="15,0" />
            <Label Grid.Column="3" Text="Total" FontAttributes="Bold" HorizontalOptions="End" />
        </Grid>

        <!-- Items List -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding CartItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='${0:F2}'}" HorizontalOptions="End" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding Quantity}" HorizontalOptions="End" Margin="15,0" VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="{Binding LineTotal, StringFormat='${0:F2}'}" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Totals -->
        <Grid Grid.Row="3" Margin="0,10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <BoxView Grid.Row="0" Grid.ColumnSpan="2" HeightRequest="1" HorizontalOptions="Fill" />

            <Label Grid.Row="1" Grid.Column="0" Text="Subtotal:" HorizontalOptions="End" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}" HorizontalOptions="End" />

            <Label Grid.Row="2" Grid.Column="0" Text="{Binding TaxRateValue, StringFormat='Tax ({0:F1}%):'}" HorizontalOptions="End" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TaxAmount, StringFormat='${0:F2}'}" HorizontalOptions="End" />

            <BoxView Grid.Row="3" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="Black" HorizontalOptions="Fill" />
        </Grid>

        <!-- Final Total -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Text="TOTAL:" FontAttributes="Bold" FontSize="18" HorizontalOptions="End" />
            <Label Grid.Column="1" Text="{Binding Total, StringFormat='${0:F2}'}" FontAttributes="Bold" FontSize="18" HorizontalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
