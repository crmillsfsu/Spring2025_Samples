<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.InventoryManagementView"
             Title="InventoryManagementView"
             NavigatedTo="ContentPage_NavigatedTo"
             >
    <VerticalStackLayout>
        <!-- Search Bar and Button -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Entry Text="{Binding Query}" Grid.Column="0"/>
            <Button Text="Search" Grid.Column="1" Clicked="SearchClicked"/>
        </Grid>

        <!-- Sorting Buttons (now below the search bar) -->
        <HorizontalStackLayout>
            <Button Text="Sort by Name" Clicked="SortByNameClicked"/>
            <Button Text="Sort by Price" Clicked="SortByPriceClicked"/>
        </HorizontalStackLayout>
        <ListView
            ItemsSource="{Binding Path=Products}"
            SelectedItem="{Binding SelectedProduct}"
            >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Display}"/>
                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='${0:F2}'}"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Add" Clicked="AddClicked"/>
        <Button
      Text="Edit"
         Clicked="EditClicked"
      />
        <Button
      Text="Delete"
      Clicked="DeleteClicked"
      />
        <Button
            Text="Go Back"
            Clicked="CancelClicked"
            />
    </VerticalStackLayout>
</ContentPage>